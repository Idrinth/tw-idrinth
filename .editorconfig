# EditorConfig - https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Lua scripts
[*.lua]
indent_style = space
indent_size = 4

# Database and localization tables
[*.tsv]
indent_style = tab
trim_trailing_whitespace = false

# XML/TWUI files
[*.xml]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Steam Workshop descriptions
[*.steam]
trim_trailing_whitespace = false

# YAML configuration
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON configuration
[*.json]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Python scripts
[*.py]
indent_style = space
indent_size = 4

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 2
